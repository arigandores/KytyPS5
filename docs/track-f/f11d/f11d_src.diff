+	    Binary(state, spv::OpINotEqual, TypeBool(state), count, ConstantU32(state, 0));
+	EmitIfCondition(state, AndCondition(state, elected, nonzero),
+	                [&]() { AtomicTailU32(state, spv::OpAtomicIAdd, DiagWordBase + word, count); });
+}
