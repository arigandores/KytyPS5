+Libs::Graphics::FaultAreaParse ParseFaultAreaCopy(const uint64_t* area, bool clamp,
+                                                  const Libs::Graphics::FaultAreaVisitor& visit,
+                                                  const Libs::Graphics::FaultAreaPass& pass = {}) {
+	static uint64_t                overflow_total = 0;
+	constexpr uint32_t             last_record    = 1023;
+	Libs::Graphics::FaultAreaParse parse;
+	parse.raw   = static_cast<uint32_t>(area[0]);
+	parse.count = clamp ? std::min(parse.raw, last_record) : parse.raw;
+	if (clamp && parse.raw > last_record) {
+		const uint64_t total = ++overflow_total;
+		if (total <= 32) {
+			LOGF("FixF29: overflow pass=%" PRIu64 " area=%u count=%u read=%u total=%" PRIu64 "\n", pass.pass, pass.area,
+			     parse.raw, parse.count, total);
+		}
+	}
+	for (uint32_t index = 1; index <= parse.count; ++index) {
+		visit(index, area[index]);
+	}
+	return parse;
+}
