@@ -0,0 +1,28 @@
+# F15c (HPP-514, ROADMAP s122 item 412(v)): the B4 stand target b4_race_stand in main - one CMake line after the
+# kernel_file_system_tests target (form of docs/track-f/f15a/patch_wt_f15a.py). add_kyty_full_emulator_test makes an
+# EXCLUDE_FROM_ALL executable; no add_test and no kyty_tests dependency - the stand is outside the default ctest set.
+# Anchor - whole lines; CR kept as found; fails when the anchor is not found once. Usage: python patch_f15c_cmake.py <repo root>
+import sys
+
+path = sys.argv[1] + '/CMakeLists.txt'
+data = open(path, 'rb').read()
+crlf = b'\r\n' in data
+text = data.replace(b'\r\n', b'\n').decode('utf-8')
+lines = text.split('\n')
+anchor = ['add_kyty_full_emulator_test(kernel_file_system_tests', '\t"${KYTY_TESTS_DIR}/KernelFileSystemTests.cpp")']
+hits = [i for i in range(len(lines) - 1) if lines[i] == anchor[0] and lines[i + 1] == anchor[1]]
+if len(hits) != 1:
+    print('ANCHOR hits', len(hits))
+    sys.exit(1)
+i = hits[0] + 2
+add = ['',
+       '# Track F, B4 exit race stand (F15a, F15c; ROADMAP s122 item 412(v)): run by docs/track-f/f15c/run_stand_f15c.py,',
+       '# not by ctest.',
+       'add_kyty_full_emulator_test(b4_race_stand',
+       '\t"${KYTY_TESTS_DIR}/B4RaceStand.cpp")']
+lines[i:i] = add
+out = '\n'.join(lines).encode('utf-8')
+if crlf:
+    out = out.replace(b'\n', b'\r\n')
+open(path, 'wb').write(out)
+print('PATCH OK line', i + 1, 'crlf', crlf)
diff --git a/docs/track-f/f15c/patch_f15c_src.py b/docs/track-f/f15c/patch_f15c_src.py
new file mode 100644
index 00000000..5989d49e
--- /dev/null
+++ b/docs/track-f/f15c/patch_f15c_src.py
@@ -0,0 +1,116 @@
+# F15c (HPP-514, ROADMAP s122 items 412(v), 417(b)-(v), row B4): KYTY_FIX_B4 (default 0) in src/kernel/fileSystem.cpp.
+# Anchors - whole lines (a block replace - whole consecutive lines); CR stripped before the search and restored after;
+# fails when an anchor is not found exactly once. Usage: python patch_f15c_src.py <repo root>
+import sys
+
+root = sys.argv[1]
+path = root + '/src/kernel/fileSystem.cpp'
+data = open(path, 'rb').read()
+crlf = b'\r\n' in data
+text = data.replace(b'\r\n', b'\n').decode('utf-8')
+lines = text.split('\n')
+
+
+def find_block(block):
+    n = len(block)
+    hits = [i for i in range(len(lines) - n + 1) if lines[i:i + n] == block]
+    if len(hits) != 1:
+        print('ANCHOR hits', len(hits), repr(block[0]))
+        sys.exit(1)
+    return hits[0]
+
+
+# 1. Declaration of FlushAll after CloseAll in class FileDescriptors.
+i = find_block(['\tFile* GetFile(const std::filesystem::path& real_name);', '\tvoid  CloseAll();'])
+lines[i + 2:i + 2] = ['\tvoid  FlushAll();']
+
+# 2. The knob and the host constant after the two globals.
+i = find_block(['static MountPoints*     g_mount_points = nullptr;', 'static FileDescriptors* g_files        = nullptr;'])
+lines[i + 2:i + 2] = [
+    '',
+    '// Track F, F15c (ROADMAP s122 items 412(v), 417(b)-(v), row B4): KYTY_FIX_B4 (default 0), read once. At 1 the',
+    '// emergency exit path (at_quick_exit and atexit(KytyClose) of src/emulator.cpp, both end in EmergencyShutdown below)',
+    '// keeps every File object, slot and host descriptor: guest threads are still running there and may hold a File* from',
+    '// GetFile without m_mutex, so CloseAll deleting it races with them (DeleteDescriptor / KernelOpen EXIT_IF or a',
+    '// use-after-free). The OS closes the host descriptors at the end of the process. Unset or empty - OFF.',
+    'static bool FixB4Enabled() {',
+    '\tstatic const bool enabled = Common::EnvValueOn(std::getenv("KYTY_FIX_B4"));',
+    '\treturn enabled;',
+    '}',
+    '',
+    '// Host write path with a user-space buffer that _Exit does not flush: stdio fwrite on non-Windows hosts',
+    '// (sysLinuxFileIO.cpp SysFileWrite). Windows SysFileWrite is WriteFile with no user buffer (sysWindowsFileIO.cpp).',
+    'constexpr bool HOST_FILE_WRITE_BUFFERED = (KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS);',
+]
+
+# 3. FlushAll definition after CloseAll (before MountPoints::Mount).
+i = find_block(['void MountPoints::Mount(const std::filesystem::path& folder, const std::string& point) {'])
+lines[i:i] = [
+    '// B4, KYTY_FIX_B4=1 (variant A\', ROADMAP s122 item 417(v)): flush the user buffer of every open writable host file',
+    '// and nothing else - no Close, no delete, no nullptr. On Windows there is no user buffer: nothing is done.',
+    'void FileDescriptors::FlushAll() {',
+    '\tif constexpr (HOST_FILE_WRITE_BUFFERED) {',
+    '\t\tCommon::LockGuard lock(m_mutex);',
+    '',
+    '\t\tfor (auto* f: m_files) {',
+    '\t\t\tif (f != nullptr && f->opened && f->writable && !f->directory &&',
+    '\t\t\t    f->special == SpecialFile::None) {',
+    '\t\t\t\tf->f.Flush();',
+    '\t\t\t}',
+    '\t\t}',
+    '\t}',
+    '}',
+    '',
+]
+
+# 4. Initialize / EmergencyShutdown / Shutdown.
+old = [
+    'void Initialize() {',
+    '\tg_mount_points = new MountPoints;',
+    '\tg_files        = new FileDescriptors;',
+    '}',
+    '',
+    'void EmergencyShutdown() {',
+    '\tif (g_files != nullptr) {',
+    '\t\tg_files->CloseAll();',
+    '\t}',
+    '}',
+    '',
+    'void Shutdown() {',
+    '\tEmergencyShutdown();',
+    '\tdelete g_files;',
+]
+new = [
+    'void Initialize() {',
+    '\tg_mount_points = new MountPoints;',
+    '\tg_files        = new FileDescriptors;',
+    '',
+    '\tLOGF("FixB4: mode=%d\\n", FixB4Enabled() ? 1 : 0);',
+    '}',
+    '',
+    'void EmergencyShutdown() {',
+    '\tif (g_files != nullptr) {',
+    '\t\tif (FixB4Enabled()) {',
+    '\t\t\t// B4: guest threads may still be inside KernelOpen/KernelClose with a File* of a slot.',
+    '\t\t\tg_files->FlushAll();',
+    '\t\t} else {',
+    '\t\t\tg_files->CloseAll();',
+    '\t\t}',
+    '\t}',
+    '}',
+    '',
+    '// Path without guest threads (Subsystems::Destroy: tests, stands): CloseAll at both values of KYTY_FIX_B4.',
+    'void Shutdown() {',
+    '\tif (g_files != nullptr) {',
+    '\t\tg_files->CloseAll();',
+    '\t}',
+    '\tdelete g_files;',
+]
+i = find_block(old)
+lines[i:i + len(old)] = new
+
+out = '\n'.join(lines).encode('utf-8')
+if crlf:
+    out = out.replace(b'\n', b'\r\n')
+open(path, 'wb').write(out)
+print('PATCH OK crlf', crlf)
diff --git a/docs/track-f/f15c/run_stand_f15c.py b/docs/track-f/f15c/run_stand_f15c.py
new file mode 100644
index 00000000..741706d5
--- /dev/null
+++ b/docs/track-f/f15c/run_stand_f15c.py
@@ -0,0 +1,118 @@
+# F15c (HPP-514, ROADMAP s122 item 412(g)(1)-(3)): driver of the B4 stand tests/B4RaceStand.cpp (target b4_race_stand) -
+# one process per trial; copy of docs/track-f/f15a/run_stand_f15a.py with the knob, plane D and the log check added.
+# Usage: python run_stand_f15c.py <exe> <mode A|B|C|D|L> <N> <out.tsv> <fix none|0|1> [first_seed]
+# The child environment: every KYTY_* variable removed, then KYTY_FIX_B4=<fix> unless fix is 'none'.
+# Halts before a trial when C:/kyty/SEALED_RUN.lock or C:/kyty/f287/STOP exists (rule 27, rule 26).
+# Classes A/B/C: FATAL207 (DeleteDescriptor EXIT_IF m_files[index] == nullptr), FATAL446 (KernelOpen EXIT_IF after
+# GetFile), FATAL_OTHER, CLEAN, CRASH (exit code not 0/77), TIMEOUT (60 s per trial, the stand itself ends in < 3 s).
+# F15a matched the fatal by the line numbers :207 / :446 of fileSystem.cpp; the fix moves them (+14 lines above both),
+# so the class is decided by the line text of the source file the stand was built from (argument-free: the path in the
+# FATAL line is the compile-time __FILE__, read here).
+# Class D: DATA_OK (exit 0, last line 'DATA 65536 fstat=65536', file on disk = pattern byte for byte), DATA_BAD (file
+# differs or missing - first differing offset in the line), CRASH, TIMEOUT. Pattern byte i: (i*131 + seed*17 + (i>>8)) & 0xFF.
+# Class L: LOG_OK (exit 0, 'LOGCHECK' and exactly one 'FixB4: mode=<expected>' line, expected 1 for fix=1 else 0), LOG_BAD.
+import collections, hashlib, os, re, subprocess, sys, time
+
+exe, mode, n, out, fix = os.path.abspath(sys.argv[1]), sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5]
+first = int(sys.argv[6]) if len(sys.argv) > 6 else 1
+assert mode in ('A', 'B', 'C', 'D', 'L') and fix in ('none', '0', '1')
+cwd = os.path.join(os.path.dirname(os.path.abspath(out)), 'cwd_' + mode)
+os.makedirs(cwd, exist_ok=True)
+sha = hashlib.sha256(open(exe, 'rb').read()).hexdigest()
+env = {k: v for k, v in os.environ.items() if not k.upper().startswith('KYTY_')}
+if fix != 'none':
+    env['KYTY_FIX_B4'] = fix
+expected_mode = '1' if fix == '1' else '0'
+fatal_line_text = {}
+
+
+def fatal_class(loc):
+    # loc = '<path>:<line>' as printed by the stand from __FILE__/__LINE__ of the fatal site.
+    path, _, line = loc.rpartition(':')
+    if not path.replace('\\', '/').endswith('kernel/fileSystem.cpp'):
+        return 'FATAL_OTHER'
+    key = (path, line)
+    if key not in fatal_line_text:
+        try:
+            src = open(path, 'rb').read().decode('utf-8', 'replace').split('\n')
+            fatal_line_text[key] = src[int(line) - 1].strip()
+        except (OSError, ValueError, IndexError):
+            fatal_line_text[key] = ''
+    t = fatal_line_text[key]
+    if t == 'EXIT_IF(m_files[index] == nullptr);':
+        return 'FATAL207'
+    if t.startswith('EXIT_IF(file == nullptr || file->opened'):
+        return 'FATAL446'
+    return 'FATAL_OTHER'
+
+
+def pattern(seed):
+    return bytes(((i * 131 + seed * 17 + (i >> 8)) & 0xFF) for i in range(65536))
+
+
+counts = collections.Counter()
+t_start = time.time()
+with open(out, 'w', encoding='utf-8', newline='\n') as f:
+    f.write('# exe %s sha256 %s mode %s N %d first_seed %d fix %s\n' % (exe, sha, mode, n, first, fix))
+    f.write('seed\trc\tclass\tline\n')
+    done = 0
+    for seed in range(first, first + n):
+        if os.path.exists('C:/kyty/SEALED_RUN.lock') or os.path.exists('C:/kyty/f287/STOP'):
+            f.write('# HALT before seed %d (lock or STOP)\n' % seed)
+            print('HALT before seed', seed)
+            break
+        dfile = os.path.join(cwd, 'stand_data', 'd_%d.bin' % seed)
+        if mode == 'D' and os.path.exists(dfile):
+            os.remove(dfile)
+        try:
+            p = subprocess.run([exe, mode, str(seed)], cwd=cwd, env=env, capture_output=True, timeout=60)
+            rc = p.returncode
+            stdout = p.stdout.decode('utf-8', 'replace')
+            text = stdout.strip().splitlines()
+            line = text[-1] if text else ''
+        except subprocess.TimeoutExpired:
+            rc, line, stdout = None, '', ''
+        if rc is None:
+            cls = 'TIMEOUT'
+        elif mode == 'L':
+            plain = re.sub(r'\x1b\[[0-9;]*m', '', stdout)
+            modes = re.findall(r'FixB4: mode=(\d+)', plain)
+            ok = rc == 0 and line == 'LOGCHECK' and modes == [expected_mode]
+            cls = 'LOG_OK' if ok else 'LOG_BAD'
+            line = '%s modes=%s' % (line, ','.join(modes))
+        elif mode == 'D':
+            if rc == 0 and line == 'DATA 65536 fstat=65536':
+                try:
+                    got = open(dfile, 'rb').read()
+                except OSError:
+                    got = None
+                want = pattern(seed)
+                if got == want:
+                    cls = 'DATA_OK'
+                else:
+                    cls = 'DATA_BAD'
+                    if got is None:
+                        line += ' file missing'
+                    else:
+                        diff = next((i for i in range(min(len(got), len(want))) if got[i] != want[i]), min(len(got), len(want)))
+                        line += ' size %d first diff %d' % (len(got), diff)
+            else:
+                cls = 'CRASH' if not line.startswith('FATAL') else fatal_class(line.split()[1])
+        elif line.startswith('FATAL'):
+            # The interceptor printed: the fatal was reached. rc may be an access violation instead of 77 when
+            # another thread faults on a freed File between the print and _Exit (F15a smoke B seed 1002) - kept in rc.
+            cls = fatal_class(line.split()[1])
+        elif rc == 0 and line.startswith('CLEAN'):
+            cls = 'CLEAN'
+        else:
+            cls = 'CRASH'
+        counts[cls] += 1
+        done += 1
+        f.write('%d\t%s\t%s\t%s\n' % (seed, rc, cls, line))
+        f.flush()
+    f.write('# done %d wall %.1f s counts %s\n' % (done, time.time() - t_start, dict(sorted(counts.items()))))
+print('exe sha256', sha)
+print('mode', mode, 'fix', fix, 'done', done, 'of', n, 'wall %.1f s' % (time.time() - t_start))
+print('counts', dict(sorted(counts.items())))
+fat = sum(v for k, v in counts.items() if k.startswith('FATAL'))
+print('fatal %d of %d -> p_s = %.4f' % (fat, done, fat / done if done else float('nan')))
