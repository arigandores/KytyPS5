+	// other value as EnvValueOn (the form of FS4a 17adaf80).
+	static const bool enabled = [] {
+		const char* value = std::getenv("KYTY_FIX_B4");
+		return value == nullptr || value[0] == '\0' || Common::EnvValueOn(value);
