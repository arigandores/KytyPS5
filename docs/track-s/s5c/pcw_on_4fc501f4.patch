+
+bool PipelineCache::PcwDriverSaved() const {
+	// S5c, RC2 of review S5b: a raised request the writer did not serve (FinishPreparation does not count creations).
+	return SPcwMode() && m_pcw_saved_any && m_pcw_saved_created == m_pcw_created.load() && !m_pcw_want_driver.load();
