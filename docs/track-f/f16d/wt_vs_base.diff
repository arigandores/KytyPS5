+template <typename CounterEnum>
+bool LogModeSet(bool on, const char* tag, DiagSet<CounterEnum>& set) {
+	if (!on || set.mode_logged.exchange(true, std::memory_order_relaxed)) {
+		return false;
+	}
+	LOGF("%s: mode=1\n", tag);
+	return true;
+}
