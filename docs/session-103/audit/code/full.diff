+int BvhLoopCapSlot(uint64_t shader_hash) {
+	const auto& set = LoopCapConfig().set;
+	for (size_t index = 0; index < set.size(); index++) {
+		if (set[index] == shader_hash) {
+			return static_cast<int>(index);
+		}
+	}
+	return -1;
+}
