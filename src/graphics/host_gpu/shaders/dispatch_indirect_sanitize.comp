// Copies up to five indirect-argument dwords into a private slot, guarding the consuming
// vkCmdDispatchIndirect / vkCmdDraw*Indirect against garbage. Guest memory that a shader never
// wrote (dropped BDA stores, patterns like 0xDEADBEEF) would otherwise hang the host GPU.
//   mode 0 (dispatch): every argument is zeroed when any component exceeds its limit;
//   mode 1 (draw):     each argument is clamped to its limit.
// target_args[count] receives 1 when something was rejected or clamped.

#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer source_buf {
    uint source_args[];
};

layout(std430, binding = 1) writeonly buffer target_buf {
    uint target_args[];
};

layout(push_constant) uniform Params {
    uint source_dword;
    uint count;
    uint mode;
    uint pad;
    uint max0;
    uint max1;
    uint max2;
    uint max3;
    uint max4;
} params;

uint limit_of(uint i) {
    if (i == 0u) return params.max0;
    if (i == 1u) return params.max1;
    if (i == 2u) return params.max2;
    if (i == 3u) return params.max3;
    return params.max4;
}

void main() {
    uint values[5];
    uint flagged = 0u;
    for (uint i = 0u; i < 5u; i++) {
        values[i] = 0u;
    }
    for (uint i = 0u; i < params.count && i < 5u; i++) {
        uint v = source_args[params.source_dword + i];
        uint limit = limit_of(i);
        if (v > limit) {
            flagged = 1u;
            v = params.mode == 1u ? limit : 0u;
        }
        values[i] = v;
    }
    if (params.mode == 0u && flagged != 0u) {
        for (uint i = 0u; i < 5u; i++) {
            values[i] = 0u;
        }
    }
    for (uint i = 0u; i < params.count && i < 5u; i++) {
        target_args[i] = values[i];
    }
    target_args[min(params.count, 5u)] = flagged;
}
