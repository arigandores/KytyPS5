+		if (vibration) {
+			PadOutputApply([&] { ApplyVibration(id, motor[0], motor[1]); });
+		}
+		if (light_bar) {
+			PadOutputApply([&] { ApplyLightBar(id, color[0], color[1], color[2]); });
+		}
+		if (effect) {
