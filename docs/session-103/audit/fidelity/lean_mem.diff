+void AtomicTailU32(EmitterState& state, spv::Op op, uint32_t word, uint32_t value) {
+	const auto result = state.builder.AllocateId();
+	state.builder.AddFunction(op, TypeU32(state), result,
+	                          FaultElementPointer(state, ConstantU32(state, word)),
+	                          ConstantU32(state, spv::ScopeDevice),
+	                          ConstantU32(state, spv::MemorySemanticsMaskNone), value);
+}
+
+} // namespace
+
+// KYTY_BVH_LOOP_CAP: this invocation spent its whole step budget and returns now.
+void EmitLoopCapTrip(EmitterState& state, uint32_t budget) {
+	if (state.fault_buffer_variable == 0) {
+		return;
+	}
+	AtomicTailU32(state, spv::OpAtomicIAdd, LoopTripWordBase + 0, ConstantU32(state, 1));
+	AtomicTailU32(state, spv::OpAtomicUMax, LoopTripWordBase + 2, budget);
+	AtomicTailU32(state, spv::OpAtomicIAdd, LoopTripWordBase + 8 + state.loop_cap_slot,
+	              ConstantU32(state, 1));
+}
+
+// KYTY_BVH_LOOP_CAP: at a normal return, count the invocations that spent more than 1/16 of the
+// budget (the margin rule: the largest legitimate walk times 16 must stay within the cap).
+void EmitLoopCapNear(EmitterState& state) {
+	if (state.loop_cap_budget_variable == 0 || state.fault_buffer_variable == 0) {
+		return;
+	}
+	const auto spent = state.builder.AllocateId();
+	state.builder.AddFunction(spv::OpLoad, TypeU32(state), spent, state.loop_cap_budget_variable);
+	const auto beyond = Binary(state, spv::OpUGreaterThan, TypeBool(state), spent,
+	                         ConstantU32(state, state.loop_cap_limit >> 4));
+	EmitIfCondition(state, beyond, [&]() {
+		AtomicTailU32(state, spv::OpAtomicIAdd, LoopTripWordBase + 1, ConstantU32(state, 1));
+		AtomicTailU32(state, spv::OpAtomicUMax, LoopTripWordBase + 2, spent);
+	});
+}
