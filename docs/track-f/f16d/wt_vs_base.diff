+	DrawsIdx,
+	DrawsAuto,
+	DrawsInd,
+	DrawsMesh,
+	PsDraws,
+	SBound,
+	SAddr0Fmt,
+	SAddr0NoFmt,
+	SMask0Addr,
+	SEmpty,
+	HBound,
+	BoundMissing,
+	BoundExtra,
+	WTotal,
+	WBound,
+	WMask0,
+	WAddr0Fmt,
+	WAddr0NoFmt,
+	WGe8,
+	Count
+};
