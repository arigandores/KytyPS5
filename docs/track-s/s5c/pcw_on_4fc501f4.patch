+	uint64_t       next_forced = force_us != 0 ? HostMicros() + force_us : 0;
+	for (;;) {
+		{
+			std::unique_lock<std::mutex> lock(m_pcw_mutex);
+			m_pcw_cv.wait_for(lock, std::chrono::milliseconds(100), [this] { return m_pcw_stop; });
+			if (m_pcw_stop) {
+				return; // Save() writes what is left
